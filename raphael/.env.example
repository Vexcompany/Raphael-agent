# Raphael v0.1 — environment variables
# Copy this file to .env.local for local development.
# NEVER commit real keys.

# Secret API key for the AI provider (server-side only, required).
AI_API_KEY=

# Base URL of any OpenAI-compatible Chat Completions API (optional).
# Default: https://api.openai.com/v1
# Examples:
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
#   DeepSeek:   https://api.deepseek.com/v1
AI_BASE_URL=https://api.openai.com/v1

# Model id to use (optional). Default: gpt-4o-mini
AI_MODEL=gpt-4o-mini
