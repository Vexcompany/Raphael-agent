# Raphael v0.1 — environment variables
# Copy this file to .env.local for local development.
# NEVER commit real keys.

# Ryzumi AI provider configuration (server-side only).
# The API key is read only on the server and never exposed to the browser.

# Secret API key for the Ryzumi AI API.
RYZUMI_API_KEY=

# Base URL of the Ryzumi OpenAI-compatible API. The chat endpoint is
# {RYZUMI_BASE_URL}/chat/completions (never append that path here).
RYZUMI_BASE_URL=https://ai.ryzumi.net/v1

# Optional server-side default model used only when the client does not
# send one. The chat UI has its own model selector (defaults to "auto") and
# always sends the exact model id with each request, so this is just a
# defensive fallback for API clients that omit the model.
# Example: deepseek-v4-flash
RYZUMI_MODEL=
