# Raphael v0.1 — environment variables
# Copy this file to .env.local for local development.
# NEVER commit real keys.

# Ryzumi AI provider configuration (server-side only).
# The API key is read only on the server and never exposed to the browser.

# Secret API key for the Ryzumi AI API.
RYZUMI_API_KEY=

# Base URL of the Ryzumi OpenAI-compatible API. The chat endpoint is
# {RYZUMI_BASE_URL}/chat/completions (never append that path here).
RYZUMI_BASE_URL=https://ai.ryzumi.net/v1

# Optional server-side default model used only when the client does not
# send one. The chat UI has its own model selector (defaults to "auto") and
# always sends the exact model id with each request, so this is just a
# defensive fallback for API clients that omit the model.
# Example: deepseek-v4-flash
RYZUMI_MODEL=

# ---------------------------------------------------------------------
# GitHub App integration ("Axiom AI RV") — server-side only.
# When these are set, the agent gains real GitHub tools (inspect repos,
# read/write files, branches, commits, PRs, Actions). When unset, the
# agent honestly says GitHub is not connected.
#
# The OAuth client id/secret are not used by the server-side tools; they
# are listed here because the GitHub App requires them. The private key is
# the app's PEM. If you paste it as a Vercel env var, newlines are usually
# stored as literal \n and are handled automatically.
# ---------------------------------------------------------------------

# GitHub App id (the app that owns "Axiom AI RV").
GITHUB_APP_ID=

# OAuth credentials of the same GitHub App (unused server-side).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Private key of the GitHub App (PEM, \n-escaped newlines are accepted).
GITHUB_PRIVATE_KEY=

# Optional identity used for commits authored by the agent.
# GITHUB_BOT_NAME=axiom-ai-rv[bot]
# GITHUB_BOT_EMAIL=axiom-ai-rv[bot]@users.noreply.github.com

# Optional GitHub REST base URL override (tests/local proxies only).
# GITHUB_API_BASE_URL=https://api.github.com
