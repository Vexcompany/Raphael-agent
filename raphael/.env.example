# Raphael v0.1 — environment variables
# Copy this file to .env.local for local development.
# NEVER commit real keys.

# Ryzumi AI provider configuration (server-side only, all required).
# The API key is read only on the server and never exposed to the browser.

# Secret API key for the Ryzumi AI API.
RYZUMI_API_KEY=

# Base URL of the Ryzumi OpenAI-compatible Chat Completions API.
# Example: https://api.ryzumi.example.com/v1
RYZUMI_BASE_URL=

# Model id to use (passed exactly as configured to the Ryzumi API).
RYZUMI_MODEL=
